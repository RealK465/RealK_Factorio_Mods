{
  "outputStyle": "Concise",
  "permissions": {
    "deny": [
      "Edit(mod-list.json)",
      "Write(mod-list.json)",
      "Edit(mod-settings.dat)",
      "Write(mod-settings.dat)",
      "Edit(mod-settings.json)",
      "Write(mod-settings.json)",
      "Edit(*.zip)",
      "Write(*.zip)",
      "Edit(**/*.zip)",
      "Write(**/*.zip)",
      "Edit(exemples/**)",
      "Write(exemples/**)",
      "Read(./.claude/settings.local.json)",
      "Read(**/settings.local.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)",
      "Edit(**/settings.local.json)",
      "Write(**/settings.local.json)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-ChildItem Env:*)",
      "PowerShell(gci Env:*)"
    ]
  }
}
